# Copy this file to `.env` (repo root, and/or `backend/.env`) and fill in
# real values. NEVER commit your actual `.env` file (it's git-ignored).

# --- LLM provider ------------------------------------------------------
# "openai" (default, tested) or "anthropic"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
LLM_TEMPERATURE=0.0

# --- Postgres (prompts, clients/documents history, LangGraph checkpoints) --
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tax_intake
# Local dev (no Docker): localhost. Inside docker-compose: host "postgres".
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tax_intake

# --- Documents -------------------------------------------------------------
# Where uploaded documents are stored (git-ignored).
UPLOAD_DIR=./data/uploads
# Where the bundled synthetic sample documents live. Local dev: one level
# up from backend/. Docker: mounted read-only at /app/sample-data.
SAMPLE_DATA_DIR=../sample-data

# --- Cross-check policy -----------------------------------------------------
# Fuzzy counterparty-name match threshold (0-1) used when matching an
# extracted employer/payer/partnership/bank name against the client's
# expected-documents checklist and against previously received documents.
COUNTERPARTY_MATCH_THRESHOLD=0.72

# --- API / CORS ----------------------------------------------------------
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend --------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
